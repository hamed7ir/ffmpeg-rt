# ffmpeg-rt CMake toolchain for zlib, desktop Windows x86 (i686-pc-windows-msvc).
# Template: scripts/gen-rsp.sh expands it into cross/cmake-x86.cmake. The x86 twin of
# cmake-arm32.cmake.in: MSVC pinned, SDK @WINSDKINCVER@ headers and libraries, static CRT.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86)
set(CMAKE_SYSTEM_VERSION 10.0)

set(_RT "@RT2@")
set(_PIN "--target=i686-pc-windows-msvc -vctoolsdir \"@VCTOOLS@\" -winsdkdir \"@WINSDK@\" -winsdkversion @WINSDKINCVER@")
set(CMAKE_C_COMPILER   "${_RT}/clang-cl.exe")
set(CMAKE_AR           "${_RT}/llvm-lib.exe")
set(CMAKE_LINKER       "${_RT}/lld-link.exe")
set(CMAKE_RC_COMPILER  "${_RT}/llvm-rc.exe")
set(CMAKE_MT           "${_RT}/llvm-mt.exe")
set(CMAKE_C_FLAGS_INIT "${_PIN}")
set(CMAKE_RC_FLAGS_INIT "-I \"@VCTOOLS@/include\" -I \"@WINSDK@/Include/@WINSDKINCVER@/um\" -I \"@WINSDK@/Include/@WINSDKINCVER@/shared\" -I \"@WINSDK@/Include/@WINSDKINCVER@/ucrt\"")
set(_LIBPATHS "/libpath:\"@VCTOOLS@/lib/x86\" /libpath:\"@WINSDK@/Lib/@WINSDKINCVER@/ucrt/x86\" /libpath:\"@WINSDK@/Lib/@WINSDKINCVER@/um/x86\"")
set(CMAKE_EXE_LINKER_FLAGS_INIT    "${_LIBPATHS}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${_LIBPATHS}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${_LIBPATHS}")
set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded")
cmake_policy(SET CMP0091 NEW)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
