# ffmpeg-rt meson cross file for dav1d, desktop Windows x86 (clang-cl, lld-link, llvm-lib), static CRT.
# Template: scripts/gen-rsp.sh expands it into cross/meson-x86.ini. dav1d's x86 SIMD needs nasm on
# PATH; scripts/build-deps.sh puts NASM's folder and RT2 first on PATH.
[binaries]
c = ['@RT2@/clang-cl.exe', '--target=i686-pc-windows-msvc', '-vctoolsdir', '@VCTOOLS@', '-winsdkdir', '@WINSDK@', '-winsdkversion', '@WINSDKINCVER@']
cpp = ['@RT2@/clang-cl.exe', '--target=i686-pc-windows-msvc', '-vctoolsdir', '@VCTOOLS@', '-winsdkdir', '@WINSDK@', '-winsdkversion', '@WINSDKINCVER@']
ar = '@RT2@/llvm-lib.exe'
windres = '@RT2@/llvm-rc.exe'
strip = '@RT2@/llvm-strip.exe'

[built-in options]
c_link_args = ['/libpath:@VCTOOLS@/lib/x86', '/libpath:@WINSDK@/Lib/@WINSDKINCVER@/ucrt/x86', '/libpath:@WINSDK@/Lib/@WINSDKINCVER@/um/x86']
cpp_link_args = ['/libpath:@VCTOOLS@/lib/x86', '/libpath:@WINSDK@/Lib/@WINSDKINCVER@/ucrt/x86', '/libpath:@WINSDK@/Lib/@WINSDKINCVER@/um/x86']
b_vscrt = 'mt'

[host_machine]
system = 'windows'
cpu_family = 'x86'
cpu = 'i686'
endian = 'little'
